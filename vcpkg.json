{
  "name": "planet",
  "builtin-baseline": "74f5ea45ca78988784b810ad9bbb148ea7ff76d8",
  "dependencies": [
    "fmt",
    "assimp",
    "enet",
    "freetype",
    "libnoise",
    "glew",
    "glm",
    "xxhash",
    "shader-slang",
    "simdutf"
  ],
  "default-features": [
    "system-sdl2"
  ],
  "features": {
    "system-sdl2": {
      "description": "Use sdl2 backend",
      "dependencies": [
        {
          "name": "sdl2",
          "default-features": false,
          "features": [
            "x11"
          ],
          "platform": "linux"
        },
        {
          "name": "sdl2",
          "platform": "!linux"
        }
      ]
    },
    "test": {
      "description": "Tests",
      "dependencies": [ "gtest" ]
    }
  }
}
